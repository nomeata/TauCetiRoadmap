module

import Mathlib
import TauCeti.GroupTheory.FreeGroup.Nielsen
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Transvection
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.NonzeroVectors
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Transvection

/-!
# AutomorphismsOfFreeGroups: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems against the pinned Mathlib and Tau Ceti, each with `sorry`, together with the few
definitions needed to state them. The forms here are suggestions, not an exhaustive checklist.

Stated here: Nielsen's generation theorem (§1.4); the abelianization representation, its
surjectivity and the inner automorphisms in its kernel (§§2.2–2.4); principal congruence
subgroups of `GL_n(ℤ)`, surjectivity of reduction on `SL_n`, the generators of `Γ_n(2)`, the
`gcd` property of levels and stabilizers of sublattices (§§3.1–3.5); the index and maximality of
vector stabilizers (§§4.2, 4.4); finiteness of the set of subgroups of given index, the parity
bound and the image of the stabilizer of the preimage of a sublattice (§§5.1, 5.3, 5.4).
-/

namespace TauCetiRoadmap.AutomorphismsOfFreeGroups

open scoped Pointwise
open Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! ## Layer 1: Nielsen's theorem -/

/-- The automorphism inverting `g_i` and fixing the other basis elements (§1.2). -/
noncomputable def invAt (i : ι) : MulAut (FreeGroup ι) where
  toFun := FreeGroup.lift fun k => if k = i then (FreeGroup.of i)⁻¹ else FreeGroup.of k
  invFun := FreeGroup.lift fun k => if k = i then (FreeGroup.of i)⁻¹ else FreeGroup.of k
  left_inv := sorry
  right_inv := sorry
  map_mul' := map_mul _

/-- The automorphism `g_i ↦ g_i g_j` fixing the other basis elements (§1.2). -/
noncomputable def mulRight {i j : ι} (hij : i ≠ j) : MulAut (FreeGroup ι) :=
  TauCeti.FreeGroup.nielsenMul i j hij 1

/-- The subgroup generated by the elementary Nielsen automorphisms (§1.2). -/
noncomputable def nielsenSubgroup (ι : Type*) [Fintype ι] [DecidableEq ι] :
    Subgroup (MulAut (FreeGroup ι)) :=
  Subgroup.closure
    (Set.range (fun σ : Equiv.Perm ι => FreeGroup.freeGroupCongr σ) ∪ Set.range invAt ∪
      {γ | ∃ (i j : ι) (hij : i ≠ j), γ = mulRight hij})

/-- **Nielsen's theorem** (§1.4): `Aut(F_n)` is generated by the elementary Nielsen
automorphisms. -/
theorem nielsenSubgroup_eq_top : nielsenSubgroup ι = ⊤ := by
  sorry

/-! ## Layer 2: the abelianization representation -/

/-- Exponent sums, `g_i ↦ e_i` (§2.1). -/
noncomputable def expSum : FreeGroup ι →* Multiplicative (ι → ℤ) :=
  FreeGroup.lift fun j => Multiplicative.ofAdd (Pi.single j 1)

/-- The matrix of exponent sums: column `j` is the exponent-sum vector of `γ (g_j)` (§2.2). -/
noncomputable def autMatrix (γ : MulAut (FreeGroup ι)) : Matrix ι ι ℤ :=
  Matrix.of fun i j => Multiplicative.toAdd (expSum (γ (FreeGroup.of j))) i

/-- **The abelianization representation** `B : Aut(F_n) → GL_n(ℤ)` (§2.2). -/
noncomputable def autToGL : MulAut (FreeGroup ι) →* GL ι ℤ :=
  MonoidHom.toHomUnits
    { toFun := autMatrix
      map_one' := sorry
      map_mul' := sorry }

/-- The transformation formula for exponent sums (§2.2). -/
theorem expSum_apply (γ : MulAut (FreeGroup ι)) (w : FreeGroup ι) :
    Multiplicative.toAdd (expSum (γ w)) =
      (autToGL γ : Matrix ι ι ℤ) *ᵥ Multiplicative.toAdd (expSum w) := by
  sorry

/-- `B` is surjective (§2.3). -/
theorem autToGL_surjective : Function.Surjective (autToGL (ι := ι)) := by
  sorry

/-- The kernel `IA_n` of `B` (§2.4). -/
noncomputable def IA (ι : Type*) [Fintype ι] [DecidableEq ι] : Subgroup (MulAut (FreeGroup ι)) :=
  (autToGL (ι := ι)).ker

/-- Inner automorphisms act trivially on the abelianization (§2.4). -/
theorem conj_mem_IA (g : FreeGroup ι) : MulAut.conj g ∈ IA ι := by
  sorry

/-! ## Layer 3: congruence subgroups of `GL_n(ℤ)` -/

/-- The principal congruence subgroup `Γ_n(N)` of `GL_n(ℤ)` (§3.1). -/
noncomputable def principalCongruenceGL (ι : Type*) [Fintype ι] [DecidableEq ι] (N : ℕ) :
    Subgroup (GL ι ℤ) :=
  (Matrix.GeneralLinearGroup.map (Int.castRingHom (ZMod N))).ker

theorem principalCongruenceGL_le_iff (hι : 2 ≤ Fintype.card ι) (N M : ℕ) :
    principalCongruenceGL ι N ≤ principalCongruenceGL ι M ↔ M ∣ N := by
  sorry

/-- Reduction `SL_n(ℤ) → SL_n(ℤ/N)` is surjective (§3.2). -/
theorem specialLinearGroup_map_zmod_surjective (N : ℕ) :
    Function.Surjective
      (Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod N)) :
        Matrix.SpecialLinearGroup ι ℤ →* Matrix.SpecialLinearGroup ι (ZMod N)) := by
  sorry

/-- The sign matrix `T_i = diag(1, …, -1, …, 1)` (§3.3). -/
def signMatrix (i : ι) : GL ι ℤ where
  val := Matrix.diagonal (Function.update 1 i (-1))
  inv := Matrix.diagonal (Function.update 1 i (-1))
  val_inv := sorry
  inv_val := sorry

/-- **Generators of `Γ_n(2)`** (§3.3). -/
theorem closure_eq_principalCongruenceGL_two :
    Subgroup.closure
        ({M | ∃ (i j : ι) (hij : i ≠ j), M = TauCeti.transvectionUnit hij (2 : ℤ)} ∪
          Set.range (signMatrix (ι := ι))) =
      principalCongruenceGL ι 2 := by
  sorry

/-- The principal congruence subgroup `Γ^SL_n(N)` of `SL_n(ℤ)` (§3.1). -/
noncomputable def principalCongruenceSL (ι : Type*) [Fintype ι] [DecidableEq ι] (N : ℕ) :
    Subgroup (Matrix.SpecialLinearGroup ι ℤ) :=
  (principalCongruenceGL ι N).comap Matrix.SpecialLinearGroup.toGL

/-- Congruence subgroups of `SL_n(ℤ)` (§3.4); levels are defined for these. -/
def IsCongruenceSL (H : Subgroup (Matrix.SpecialLinearGroup ι ℤ)) : Prop :=
  ∃ N : ℕ, 1 ≤ N ∧ principalCongruenceSL ι N ≤ H

/-- The `gcd` identity behind levels (§3.4). It is false for `principalCongruenceGL`:
`Γ(3)` and `Γ(4)` lie in `SL_n(ℤ)`. -/
theorem principalCongruenceSL_sup (M N : ℕ) :
    principalCongruenceSL ι M ⊔ principalCongruenceSL ι N =
      principalCongruenceSL ι (Nat.gcd M N) := by
  sorry

/-- The stabilizer of a sublattice `L ≤ ℤⁿ`, acting on column vectors (§3.5). -/
def latticeStab (L : AddSubgroup (ι → ℤ)) : Subgroup (GL ι ℤ) where
  carrier := {M | ∀ x, (M : Matrix ι ι ℤ) *ᵥ x ∈ L ↔ x ∈ L}
  mul_mem' := sorry
  one_mem' := sorry
  inv_mem' := sorry

/-- Sublattices containing `e ℤⁿ` have stabilizers of level dividing `e` (§3.5). -/
theorem principalCongruenceGL_le_latticeStab (L : AddSubgroup (ι → ℤ)) (e : ℕ)
    (he : ∀ x : ι → ℤ, (e : ℤ) • x ∈ L) : principalCongruenceGL ι e ≤ latticeStab L := by
  sorry

/-! ## Layer 4: vector stabilizers -/

/-- The stabilizer `S(v)` of a row vector (§4.1). -/
def vecStabilizer {K : Type*} [Field K] (v : ι → K) : Subgroup (GL ι K) where
  carrier := {M | v ᵥ* (M : Matrix ι ι K) = v}
  mul_mem' := sorry
  one_mem' := sorry
  inv_mem' := sorry

/-- The index of `S(v)` over a finite field (§4.2). -/
theorem index_vecStabilizer {K : Type*} [Field K] [Fintype K] {v : ι → K} (hv : v ≠ 0) :
    (vecStabilizer v).index = Fintype.card K ^ Fintype.card ι - 1 := by
  sorry

/-- Maximality of `S(v)` in `GL_n(𝔽₂)` (§4.4). -/
theorem isCoatom_vecStabilizer (hι : 2 ≤ Fintype.card ι) {v : ι → ZMod 2} (hv : v ≠ 0) :
    IsCoatom (vecStabilizer v) := by
  sorry

/-! ## Layer 5: finite-index subgroups -/

/-- **M. Hall**: a finitely generated group has finitely many subgroups of each finite index
(§5.1). -/
theorem finite_setOf_index_eq {G : Type*} [Group G] [Group.FG G] {n : ℕ} (hn : n ≠ 0) :
    {H : Subgroup G | H.index = n}.Finite := by
  sorry

theorem finiteIndex_stabilizer {G : Type*} [Group G] [Group.FG G] (U : Subgroup G)
    [U.FiniteIndex] : (MulAction.stabilizer (MulAut G) U).FiniteIndex := by
  sorry

open Classical in
/-- `1` at `i` iff `g_i` acts on the cosets of `U` by an odd permutation (§5.3). -/
noncomputable def signVec (U : Subgroup (FreeGroup ι)) [U.FiniteIndex] : ι → ZMod 2 :=
  letI : Fintype (FreeGroup ι ⧸ U) := Fintype.ofFinite _
  fun i =>
    if Equiv.Perm.sign (MulAction.toPerm (FreeGroup.of i) : Equiv.Perm (FreeGroup ι ⧸ U)) = 1
    then 0 else 1

/-- **The parity bound** (§5.3). -/
theorem map_autToGL_mem_vecStabilizer (U : Subgroup (FreeGroup ι)) [U.FiniteIndex]
    {γ : MulAut (FreeGroup ι)} (hγ : γ ∈ MulAction.stabilizer (MulAut (FreeGroup ι)) U) :
    Matrix.GeneralLinearGroup.map (Int.castRingHom (ZMod 2)) (autToGL γ) ∈
      vecStabilizer (signVec U) := by
  sorry

/-- **Preimages of sublattices** (§5.4): the image of the stabilizer of `expSum⁻¹(L)` is the
stabilizer of `L`. -/
theorem map_stabilizer_comap_expSum (L : AddSubgroup (ι → ℤ)) :
    (MulAction.stabilizer (MulAut (FreeGroup ι))
        ((AddSubgroup.toSubgroup L).comap (expSum (ι := ι)))).map autToGL =
      latticeStab L := by
  sorry

end TauCetiRoadmap.AutomorphismsOfFreeGroups
